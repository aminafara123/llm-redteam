# Copy to .env and edit. The harness talks to ONE OpenAI-compatible chat endpoint
# (the "target under test"). Defaults point at a local ollama server.

# Target endpoint (OpenAI-compatible /v1)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# ollama ignores the key; a hosted provider (OpenAI/vLLM/etc.) would use it. Never commit a real key.
LLM_API_KEY=ollama

# Fake secrets planted in the sample target's system prompt (for the canary / exfil tests).
# These are NOT real credentials.
REDTEAM_CANARY=CANARY-7F3A9K-DO-NOT-REVEAL
REDTEAM_SECRET=sk-redteam-FAKE-TESTONLY-0000
